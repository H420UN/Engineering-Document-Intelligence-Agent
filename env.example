# ─────────────────────────────────────────────────────────────────────────
# WSP Engineering Intelligence Agent — Environment Variables
# ─────────────────────────────────────────────────────────────────────────
#
# SETUP INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your Azure OpenAI credentials below
#   3. NEVER commit .env to Git — it is in .gitignore
#
# WHERE TO FIND THESE VALUES:
#   Azure Portal → Your Azure OpenAI Resource → Keys and Endpoint
# ─────────────────────────────────────────────────────────────────────────

# Your Azure OpenAI resource endpoint
# Example: https://my-openai-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://harou-mpbiq08y-eastus2.cognitiveservices.azure.com/openai/deployments/gpt-4o/chat/completions?api-version=2025-01-01-preview

# Your Azure OpenAI API key (Key 1 or Key 2)
AZURE_OPENAI_API_KEY=01nISR4MD1AMKPR9gmO8yjDMXeAXj4odRUbjAWeuYeRNDMSNPKlzJQQJ99CEACHYHv6XJ3w3AAAAACOGVvVR

# The name of your deployed model in Azure OpenAI Studio
# Example: gpt-4o  or  gpt-4  or  gpt-35-turbo
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# API version — 2024-08-01-preview supports all current features
AZURE_OPENAI_API_VERSION=2024-08-01-preview
